@model IReadOnlyList<AgroConecta.Application.Consultas.FaturaResumo>
@{
    ViewData["Title"] = "Faturas";
    var totalAberto = Model
        .Where(fatura => fatura.Status is not AgroConecta.Domain.Enums.StatusFatura.Paga
            and not AgroConecta.Domain.Enums.StatusFatura.Cancelada)
        .Sum(fatura => fatura.Valor);
    var totalPago = Model
        .Where(fatura => fatura.Status == AgroConecta.Domain.Enums.StatusFatura.Paga)
        .Sum(fatura => fatura.Valor);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Faturas e relatórios</h1>
        <p class="text-muted mb-0">Faturamento dos pedidos e situação de pagamento.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted text-uppercase small mb-1">Em aberto</p>
                <p class="h3 mb-0">@totalAberto.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted text-uppercase small mb-1">Pagas</p>
                <p class="h3 mb-0">@totalPago.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted text-uppercase small mb-1">Total de faturas</p>
                <p class="h3 mb-0">@Model.Count</p>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Lista de faturas</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Pedido</th>
                    <th scope="col" class="text-end">Valor</th>
                    <th scope="col">Status</th>
                    <th scope="col">Emitida em</th>
                    <th scope="col">Paga em</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fatura in Model)
                {
                    <tr>
                        <td><strong>@fatura.Numero</strong></td>
                        <td><a asp-controller="PedidosWeb" asp-action="Detalhe" asp-route-id="@fatura.PedidoId">@fatura.PedidoId</a></td>
                        <td class="text-end">@fatura.Valor.ToString("C")</td>
                        <td><span class="badge @Badges.Fatura(fatura.Status)">@fatura.Status</span></td>
                        <td>@(fatura.EmitidaEm?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>@(fatura.PagoEm?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma fatura registrada.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
