@model IReadOnlyList<AgroConecta.Application.Consultas.UsuarioResumo>
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-3">
    <div>
        <h1 class="h3 mb-1">Usuários</h1>
        <p class="text-muted mb-0">Contas de acesso e papéis no sistema.</p>
    </div>
    <a asp-action="Auditoria" class="btn btn-outline-success">Trilha de auditoria</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Lista de usuários</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">E-mail</th>
                    <th scope="col">Papel</th>
                    <th scope="col">Situação</th>
                    <th scope="col">Criado em</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td><strong>@usuario.Nome</strong></td>
                        <td>@usuario.Email</td>
                        <td><span class="badge @Badges.Papel(usuario.Papel)">@usuario.Papel</span></td>
                        <td>
                            <span class="badge @(usuario.Ativo ? "bg-success" : "bg-secondary")">
                                @(usuario.Ativo ? "Ativo" : "Inativo")
                            </span>
                        </td>
                        <td>@usuario.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Nenhum usuário cadastrado.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
